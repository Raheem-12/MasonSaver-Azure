HELP.md

# Maven / Java build output
target/
*.class

# Keep source folders even if they contain folders named target or build
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar

# Local secrets and environment variables
.env
.env.*
!.env.example

# Spring local configuration containing credentials
src/main/resources/application.properties
**/src/main/resources/application.properties

# Logs
*.log

